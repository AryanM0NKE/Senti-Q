{
  "manifest_version": 3,
  "name": "Senti-Q for X",
  "version": "1.0.0",
  "description": "Analyse the X post you're looking at with Senti-Q: sentiment and hate-speech detection.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyse this post with Senti-Q",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "options_page": "options.html"
}
